    resultText: "\u4F60\u5F37\u5FCD\u8457\u810A\u690E\u767C\u6DBC\u7684\u6230\u6144\u611F\uFF0C\n\u5C07\u8996\u7DDA\u5F9E\u90A3\u6247\u9055\u80CC\u7269\u7406\u6CD5\u5247\u7684\u9580\u4E0A\u79FB\u958B\u3002\n\n\u4F60\u6709\u4E00\u7A2E\u9810\u611F\u00B7\u00B7\u00B7\n<b>\u6700\u597D\u4E0D\u8981\u63A2\u7A76\u9580\u5F8C\u7684\u666F\u8C61\u3002</b>"
