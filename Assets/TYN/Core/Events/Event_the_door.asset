    resultText: "\xB7\xB7\xB7\xB7\xB7\xB7\u4F60\u4E0D\u81EA\u89BA\u5730\u6253\u958B\u4E86\u90A3\u6247\u53E4\u602A\u7684\u9580\u3002\n\u4F46\u9084\u6C92\u4F86\u5F97\u53CA\u78BA\u8A8D\u9580\u5F8C\u7684\u666F\u8C61\uFF0C\u4F60\u5C31\u611F\u89BA\u81EA\u5DF1\u88AB\u4E00\u80A1\u5F37\u52C1\u7684\u5F15\u529B\u7D66\u6372\u5165\u3002\n\u7B49\u5230\u4F60\u770B\u6E05\u5468\u570D\u7684\u60C5\u6CC1\u6642\uFF0C\u4F60\u767C\u73FE\u81EA\u5DF1\u8655\u65BC\u672A\u77E5\u7684\u5834\u6240\u3002"
