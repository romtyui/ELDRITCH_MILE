  options:
  - label: "\u958B\u9580"
    resultText: "\u5167\u5FC3\u67D0\u7A2E\u72C2\u71B1\u7684\u597D\u5947\u5FC3\u9A45\u4F7F\u8457\u4F60\uFF0C\n\u00B7\u00B7\u00B7\u00B7\u00B7\u4F60\u4E0D\u81EA\u89BA\u5730\u628A\u624B\u4F38\u5411\u90A3\u51B0\u51B7\u7684\u9580\u628A\u3002\n\n\u4F46\u9084\u6C92\u4F86\u5F97\u53CA\u78BA\u8A8D\u9580\u5F8C\u7684\u666F\u8C61\uFF0C\n\u4F60\u5C31\u611F\u89BA\u81EA\u5DF1\u88AB\u4E00\u80A1\u5F37\u52C1\u7684\u5F15\u529B\u7D66\u6372\u5165\u3002\n\n\u4F60\u611F\u89BA\u81EA\u5DF1\u7684\u8089\u9AD4\u9023\u540C\u7A7A\u9593\u4E00\u8D77\u88AB\u6495\u88C2\uFF0C\n\u96A8\u5F8C\u88AB\u6DF1\u9083\u7684\u9ED1\u6697\u91CD\u91CD\u5305\u570D\u3002"
    arrivalText: "\u5F85\u4F60\u7684\u610F\u8B58\u91CD\u65B0\u62FC\u6E4A\u8D77\u4F86\u6642\uFF0C\n\u5468\u570D\u7684\u666F\u8272\u65E9\u5DF2\u9762\u76EE\u5168\u975E\uFF0C\u7A7A\u6C23\u4E2D\u7030\u6F2B\u8457\u964C\u751F\u7684\u6C23\u606F\n\n"
