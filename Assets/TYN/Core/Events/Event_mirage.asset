  id: mirage
  title: "\u6D77\u5E02\u8703\u6A13"
  conditions:
  - kind: 2
    key: abyss
    value: 50
  chance: 1
  once: 1
  weight: 1
  bodyText: "\u5FFD\u7136\u9592\uFF0C\u4E00\u9663\u6BDB\u9AA8\u609A\u7136\u7684\u611F\u89BA\u6D8C\u4E0A\u4F60\u7684\u5FC3\u982D\u3002\u4F60\u7A81\u7136\u7522\u751F\u4E86\u4E00\u7A2E\u9810\u611F\uFF0C\u975E\u5E38\u5F3A\u70C8\u7684\u9810\u611F\u3002\n\n\u7D55\u5C0D\u4E0D\u80FD\u5F80\u4E0A\u770B\u3002"
  image: {fileID: 0}
  options:
  - label: "\u5F80\u4E0A\u770B"
    resultText: "\u4F60\u7684\u597D\u5947\u6230\u52DD\u4E86\u4F60\u7684\u672C\u80FD\uFF0C\u4F60\u4E0D\u7531\u81EA\u4E3B\u5730\u5F80\u5929\u7A7A\u770B\u53BB\uFF0C\u65BC\u662F\u4F60\u770B\u898B\u4E86...\u5DE8\u5927\u7684\uFF0C\u90A3\u500B\u3002\n\n\u4F60\u8166\u888B\u4E2D\uFF0C\u60F3\u8D77\u4E86\u8846\u591A\u6C11\u9593\u6D41\u50B3\u7684\u6545\u4E8B\u3002\u64C1\u6709\u7F8E\u9E97\u6A23\u8C8C\uFF0C\u9577\u8457\u9B5A\u985E\u7279\u5FB5\u7684\u5973\u6027\u3002\u4EBA\u9B5A\u3002\n\u4F60\u7684\u5185\u5FC3\u6D6E\u73FE\u51FA\u4E86\u4E00\u500B\u540D\u5B57\uFF0C\u8B93\u4F60\u4E0D\u7531\u81EA\u4E3B\u5730\u5C07\u5176\u5410\u9732\u51FA\u4F86\u3002\u300C\u516B\u767E\u6BD4\u4E18\u5C3C\u300D\u3002\n\n\u5982\u540C\u5E7B\u5F71\u4E00\u822C\uFF0C\u9060\u8655\u7684\u6FC3\u9727\u6563\u53BB\u3002\u5728\u90A3\u4E00\u7AEF\u537B\u4EC0\u9EBD\u90FD\u6C92\u6709\u3002\u90A3\u662F\uFF0C\u5E7B\u5F71\u3002\u4EA6\u6216\u8005\uFF0C\u662F\u73FE\u5BE6\u3002\n\u4E5F\u8A31\uFF0C\u90A3\u53EA\u662F\u55AE\u7D14\u7684\u6D77\u5E02\u8703\u6A13\u7F77\u4E86\u3002"
    effects:
    - kind: 3
      key: 
      amount: -20
    - kind: 2
      key: abyss
      amount: 10
  - label: "\u4E0D\u5F80\u4E0A\u770B"
    resultText: "\u4F60\u6DF1\u77E5\u90A3\u662F\u7D55\u4E0D\u80FD\u76F4\u8996\u7684\u5B58\u5728\uFF0C\u65BC\u662F\u4F60\u9589\u4E0A\u773C\uFF0C\u4ECD\u7531\u9019\u4EFD\u4E0D\u7965\u7684\u6050\u61FC\u5728\u5185\u5FC3\u6E38\u8569\u3002\n\n\u5728\u9ED1\u6697\u7684\u8996\u91CE\u4E2D\uFF0C\u4F60\u7684\u611F\u5B98\u8B8A\u5F97\u683C\u5916\u654F\u92B3\u3002\u4F60\u807C\u898B\u5468\u570D\u7684\u534A\u9B5A\u4EBA\u767C\u51FA\u9663\u9663\u5636\u543C\uFF0C\u63A5\u8457\u662F\u8846\u591A\u7684\u811A\u6B65\u8072\u3002\n\u6709\u4E9B\u751A\u81F3\u7D93\u904E\u4E86\u4F60\u7684\u8EAB\u908A\uFF0C\u4F46\u4F60\u4F9D\u820A\u6C92\u6709\u775C\u958B\u773C\u3002\n\n\u7DCA\u63A5\u8457\uFF0C\u4F60\u807C\u898B\u4E86\u53E6\u4E00\u7A2E\u8072\u97F3\u3002\u90A3\u662F\uFF0C\u5973\u6027\u7684\u5636\u543C\u8072\u3002\n\u76F4\u5230\u9019\u4E9B\u8072\u97F3\u5FB9\u5E95\u6D88\u5931\u7232\u6B62\uFF0C\u4F60\u90FD\u6C92\u6709\u775C\u958B\u773C\u775B\u3002\n\n\u7136\u800C\uFF0C\u4F60\u7684\u773C\u524D\u843D\u4E0B\u4E86\u4E00\u584A\u65B0\u9BAE\u7684\u8840\u8089\u3002\u90A3\u5FC5\u7136\u662F\u6C38\u6046\u7684\u3001\u795E\u8056\u7684\u8840\u8089\uFF0C\u4F60\u4E0D\u7981\u5982\u6B64\u76F8\u4FE1\u3002"
    effects:
    - kind: 0
      key: relic_mermaid_flesh
      amount: 1
  notes: "\u5927\u7DB1\u3008\u6DF1\u6DF5\u7DDA\u3009\u3002\u5167\u6587\u6709\u7BC0\u9304\uFF08\u539F\u6587\u5F88\u9577\uFF09\uFF0C\u6548\u679C\u7167\u539F\u6587\u3002"
