    resultText: "\u4F60\u5C07\u90A3\u5F35\u6BDB\u9AA8\u609A\u7136\u7684\u5361\u724C\u4EA4\u4E86\u51FA\u53BB\uFF0C\u63DB\u53D6\u4E86\u90A3\u4E00\u888B\u91D1\u5E63\u3002\n\u63A5\u8457\uFF0C\u4ED6\u767C\u51FA\u8A6D\u7570\u7684\u7B11\u8072\uFF0C\u5C31\u9019\u9EBD\u5728\u4F60\u9762\u524D\u6D88\u5931\u4E86\u3002\n\xB7\xB7\xB7\u96D6\u7136\u6709\u4E9B\u4E0D\u77E5\u6240\u4EE5\u7136\uFF0C\u4F46\u597D\u6B79\u4F60\u5F97\u5230\u4E86\u4F60\u7684\u5BF6\u8C9D\u91D1\u5E63\u3002"
