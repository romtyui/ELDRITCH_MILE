    resultText: "\u8B1D\u8B1D\u6E2C\u8A66\uFF01\n\u5982\u679C\u53EF\u4EE5\uFF0C\u8ACB\u5E6B\u6211\u5011\u586B\u5BEB\u554F\u5377\u3002"
    effects: []
