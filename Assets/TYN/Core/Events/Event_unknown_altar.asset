    arrivalText: "\u5728\u4F60\u505A\u51FA\u4E86\u6289\u64C7\u7684\u77AC\u9593\uFF0C\n\u773C\u524D\u7684\u796D\u58C7\u7336\u5982\u6C34\u9762\u4E0A\u7684\u5012\u5F71\uFF0C\u6643\u52D5\u3001\u6D88\u6563\u2014\u2014\n\n\u6700\u7D42\uFF0C\u4E00\u5207\u518D\u5EA6\u6B78\u65BC\u6DF7\u6C8C\u3001\u6B78\u65BC\u865B\u7121\u3002\n\u4F60\u518D\u5EA6\u88AB\u9ED1\u6697\u6240\u541E\u6C92\uFF0C\u55AA\u5931\u4E86\u5100\u5F0F\u3002\n\n\u7576\u4F60\u7684\u8996\u89BA\u548C\u807D\u89BA\u91CD\u65B0\u6B78\u4F4D\uFF0C\u610F\u8B58\u518D\u5EA6\u843D\u56DE\u73FE\u5BE6\u4E4B\u6642\uFF0C\n\u4F60\u767C\u73FE\u81EA\u5DF1\u4F9D\u7136\u7AD9\u5728\u4E0D\u4E45\u524D\u8E0F\u904E\u7684\u9053\u8DEF\u4E0A\u3002"
