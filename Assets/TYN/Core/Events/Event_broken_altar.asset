    resultText: "\u4F86\u81EA\u60A0\u4E45\u6DF1\u57DF\u7684\u795E\u660E\u56DE\u61C9\u4E86\u4F60\uFF0C\u672A\u77E5\u7684\u529B\u91CF\u6D8C\u73FE\u4E86\u51FA\u4F86\u3002"
