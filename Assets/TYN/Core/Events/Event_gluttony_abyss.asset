  m_Name: Event_gluttony_abyss
  m_EditorClassIdentifier: Assembly-CSharp::EldritchMile.Core.EventData
  id: gluttony_abyss
  title: "\u66B4\u98DF\u4E4B\u6DF1\u6DF5"
  conditions: []
  chance: 1
  once: 1
  weight: 100
  bodyText: "\u6C99\u6C99\u6C99........\u8033\u908A\u97FF\u8D77\u6D77\u6D6A\u7684\u8072\u97F3\u3002\u4E00\u9663\u8165\u7C98\u7684\u6D77\u98A8\u5E36\u8457\u8150\u721B\u7684\u6C23\u5473\u671D\u4F60\u5439\u4F86\u3002\n\u5C0D\u65BC\u773C\u524D\u7684\u5834\u666F\uFF0C\u4F60\u611F\u5230\u96E3\u4EE5\u7F6E\u4FE1\u3002\u90A3\u662F\u4E00\u5EA7\u88AB\u8FF7\u9727\u570D\u7E5E\u7684\uFF0C\u6F01\u6751\u3002\n\u4F60\u89C0\u671B\u56DB\u5468\uFF0C\u767C\u73FE\u6B64\u8655\u8C8C\u4F3C\u88AB\u5927\u6D77\u6240\u570D\u7E5E\u3002\u6D77\u7684\u53E6\u4E00\u7AEF\u662F\u66F4\u52A0\u539A\u91CD\u7684\u767D\u9727\uFF0C\u5E7E\u4E4E\u770B\u4E0D\u898B\u9060\u65B9\u7684\u666F\u8272\u3002\u9019\u88CF...\u4F3C\u4E4E\u662F\u4E00\u5EA7\u5CF6\u5DBC\u4E0A\u7684\u67D0\u5EA7\u6751\u838A\u3002\n\u7232\u4F55\u4F60\u6703\u7A81\u7136\u51FA\u73FE\u5728\u9019\u88CF\uFF1F\u525B\u624D\u7684\u9053\u8DEF\u662F\u600E\u9EBD\u901A\u5230\u9019\u5EA7\u5C0F\u5CF6\u4E0A\u7684\uFF1F\n\u5F88\u5FEB\u7684\uFF0C\u4F60\u653E\u68C4\u4E86\u601D\u8003\u3002\u56E0\u7232\uFF0C\u4F60\u7684\u8166\u888B\u88AB\u53E6\u4E00\u7A2E\u8072\u97F3\u6240\u8986\u84CB\uFF0C\u4EE5\u81F4\u65BC\u4F60\u6C92\u6709\u601D\u8003\u5176\u4ED6\u554F\u984C\u7684\u7A7A\u9591\u3002\n\u2026\u2026\u597D\u9913\u3002"
  image: {fileID: 0}
  options:
  - label: 
    resultText: 
    effects:
    - kind: 2
      key: abyss
      amount: 5
  notes: "\u5927\u7DB1\u3008\u6DF1\u6DF5\u7DDA\u3009\u3002\n\u26A0\uFE0F \u89F8\u767C\u689D\u4EF6\u539F\u6587\u662F\u300C\u904A\u6232\u5167\u9996\u6B21\u8E0F\u5165\u6F01\u6751\u300D\u2014\u2014\u300C\u5340\u57DF\u300D\u7CFB\u7D71\u9084\u4E0D\u5B58\u5728\uFF0C\u6240\u4EE5\u73FE\u5728\u9760
    once=true \uFF0B \u6B0A\u91CD 100 \u8B93\u5B83\u76E1\u91CF\u7B2C\u4E00\u500B\u51FA\u73FE\u3002\n\u7B49\u5340\u57DF\u7CFB\u7D71\u505A\u597D\uFF0C\u628A\u689D\u4EF6\u6539\u6210\u300C\u65D7\u6A19
    region_village \u5DF2\u7ACB\u300D\uFF0C\u6B0A\u91CD\u8ABF\u56DE 1\u3002"
