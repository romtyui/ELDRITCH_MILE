  - optionId: curio
    text: "\u300C\u88E1\u9762\u662F\u525B\u624D\u8DEF\u908A\u64BF\u5230\u7684\u6771\u897F\u300D"
    baseProbability: 25
    acceptedAttributes: 03000000
    successText: "\u574E\u8C9D\u723E\uFF1A\u300C\u6C92\u932F\u6C92\u932F\u2014\u2014\u5C31\u662F\u6211\u525B\u624D\u5730\u4E0A\u64BF\u5230\u7684\xB7\xB7\xB7\xB7\xB7\xB7\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u2014\u2014\u4E0D\u5C0D\uFF0C\u624D\u4E0D\u662F\u5783\u573E\u5566\uFF01\u8A71\u8AAC\u70BA\u4EC0\u9EBD\u4F60\u6703\u77E5\u9053\uFF1F\u4F60\u5077\u770B\u6211\u4E86\uFF1F\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u4E00\u5B9A\u80FD\u6D3E\u4E0A\u4EC0\u9EBD\u7528\u5834\u5566\uFF0C\u5927\u6982\u3002\u5E36\u5728\u8EAB\u4E0A\u7E3D\u4E0D\u6703\u6709\u58DE\u8655\u7684\uFF01\u300D"
