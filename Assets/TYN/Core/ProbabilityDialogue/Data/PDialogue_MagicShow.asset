    baseProbability: 25
    acceptedAttributes: 01000000
    successText: "\u574E\u8C9D\u723E\uFF1A\u300C\u606D\u559C\u2014\u2014\uFF01\u4F60\u731C\u5C0D\u4E86\uFF01\u88E1\u9762\u662F\u98DF\u7269\u6C92\u932F\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u6211\u65E9\u731C\u5230\u4F60\u5DEE\u4E0D\u591A\u8A72\u809A\u5B50\u9913\u4E86\uFF0C\u5F88\u53B2\u5BB3\u5427\uFF1F\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u8981\u662F\u7D2F\u4E86\u5C31\u4E0D\u7528\u5BA2\u6C23\uFF0C\u96A8\u6642\u90FD\u53EF\u4EE5\u4F11\u606F\u54E6\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u6211\u6703\u4E00\u76F4\u5728\u4F60\u7684\u8EAB\u908A\u7684\uFF0C\u5C0D\u5427\uFF1F\u300D"
