  eventId: village_magic_show
  npcId: campbell
  background: {fileID: 0}
  initialPrompt: "\u574E\u8C9D\u723E\uFF1A\u300C\u4F86\u4E00\u5834\u9B54\u8853\u79C0\u5427\u2014\u2014\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u6B38\uFF0C\u4F60\u8AAC\u597D\u7A81\u7136\uFF1F\u9A5A\u559C\u5C31\u5F97\u9019\u6A23\u624D\u884C\u561B\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u4F86\u561B\u3001\u4F86\u561B\u2014\u2014\u6211\u9084\u7279\u5225\u70BA\u52AA\u529B\u7684\u4F60\u51C6\u5099\u4E86\u734E\u52F5\u54E6\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u597D\uFF0C\u6211\u5C31\u7576\u4F5C\u4F60\u7B54\u61C9\u4E86\uFF01\u554F\u984C\u2014\u2014\uFF01\u9019\u500B\u5E3D\u5B50\u4E2D\u85CF\u4E86\u4EC0\u9EBD\u5462\uFF1F\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u8981\u662F\u7B54\u5C0D\u4E86\uFF0C\u6211\u5C31\u628A\u5B83\u9001\u7D66\u4F60\uFF01\u51C6\u5099\u597D\u56DE\u7B54\u4E86\u55CE\uFF1F\u300D\n\n\u5E3D\u5B50\u88E1\u85CF\u4E86\u4EC0\u9EBC\xB7\xB7\xB7?"
  failurePrompts:
  - "\u574E\u8C9D\u723E\uFF1A\u300C\u5514\u2014\u2014\u5DEE\u4E00\u9EDE\u9EDE\uFF01\u300D\n\u4ED6\u628A\u5E3D\u5B50\u5F80\u4F60\u9762\u524D\u53C8\u9001\u4E86\u9001\u3002\u300C\u518D\u60F3\u60F3\uFF1F\u5E3D\u5B50\u9084\u5728\u9019\u88E1\u5462\u3002\u300D"
  - "\u574E\u8C9D\u723E\uFF1A\u300C\u6700\u5F8C\u4E00\u6B21\u6A5F\u6703\u56C9\u3002\u300D\n\u7B11\u5BB9\u6C92\u6709\u8B8A\uFF0C\u4F46\u4ED6\u7684\u624B\u6307\u5728\u5E3D\u6CBF\u4E0A\u6572\u5F97\u6BD4\u525B\u624D\u5FEB\u4E86\u4E00\u4E9B\u3002"
  finalFailureText: "\u574E\u8C9D\u723E\uFF1A\u300C\xB7\xB7\xB7\xB7\xB7\xB7\u53EF\u60DC\uFF0C\u731C\u932F\u4E86\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u8A71\u8AAC\u4F60\u6709\u8A8D\u771F\u731C\u55CE\uFF1F\u6211\u53EF\u80FD\u6709\u9EDE\u53D7\u50B7\u4E86\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\xB7\xB7\xB7\u561B\uFF0C\u96D6\u7136\u6211\u539F\u672C\u662F\u6253\u7B97\u4F60\u60F3\u8981\u4EC0\u9EBD\u5C31\u9001\u4F60\u4EC0\u9EBD\u7684\u3002\u4F46\u770B\u4F86\u6C92\u6709\u90A3\u500B\u9700\u8981\u4E86\u3002\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u4E0D\u77E5\u9053\u4F60\u6709\u6C92\u6709\u7A0D\u5FAE\u653E\u9B06\u4E00\u9EDE\u5462\uFF1F\u90A3\u6A23\u7684\u8A71\u6211\u6703\u5F88\u9AD8\u8208\u7684\uFF01\u300D"
