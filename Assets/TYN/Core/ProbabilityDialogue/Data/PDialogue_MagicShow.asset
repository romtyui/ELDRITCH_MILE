  eventId: village_magic_show
  npcId: campbell
  background: {fileID: 0}
  initialPrompt: "\u574E\u8C9D\u723E\uFF1A\u300C\u597D\uFF0C\u4F86\u8868\u6F14\u9B54\u8853\u5427\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u5225\u4E00\u526F\u300E\u9019\u7A2E\u6642\u5019\uFF1F\u300F\u7684\u8868\u60C5\u561B\uFF01\u5076\u723E\u4E5F\u5F97\u4F86\u9EDE\u5A1B\u6A02\u6D3B\u52D5\u5427\uFF1F\n\u800C\u4E14\uFF0C\u6211\u9084\u70BA\u52AA\u529B\u7684\u4F60\u6E96\u5099\u4E86\u734E\u52F5\u54E6\uFF01\u8981\u662F\u62FF\u5230\u7684\u8A71\u4E0D\u662F\u5F88\u958B\u5FC3\u55CE\uFF1F\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u90A3\u9EBC\uFF0C\u554F\u984C\uFF5E\uFF01\n\u9019\u500B\u770B\u4F3C\u5E73\u5E73\u7121\u5947\uFF0C\u4F46\u5176\u5BE6\u6697\u85CF\u7384\u6A5F\u7684\u5E3D\u5B50\u4E2D\u5230\u5E95\u85CF\u4E86\u4EC0\u9EBC\u5462\uFF1F\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u5E3D\u5B50\u4E2D\u53EF\u8B02\u662F\u6DF7\u6C8C\uFF01\u5728\u770B\u5230\u4E4B\u524D\uFF0C\u90FD\u7121\u6CD5\u78BA\u5B9A\u88E1\u9762\u96B1\u85CF\u4E86\u4EC0\u9EBC\u3002\n\u4F86\u5427\uFF01\u9019\u7A2E\u672A\u77E5\u7684\u611F\u89BA\u4E5F\u662F\u4E00\u7A2E\u523A\u6FC0\uFF01\u300D"
  failurePrompts:
  - "\u574E\u8C9D\u723E\uFF1A\u300C\u5514\u2014\u2014\u5DEE\u4E00\u9EDE\u9EDE\uFF01\u300D\n\u4ED6\u628A\u5E3D\u5B50\u5F80\u4F60\u9762\u524D\u53C8\u9001\u4E86\u9001\u3002\u300C\u518D\u60F3\u60F3\uFF1F\u5E3D\u5B50\u9084\u5728\u9019\u88E1\u5462\u3002\u300D"
  - "\u574E\u8C9D\u723E\uFF1A\u300C\u6700\u5F8C\u4E00\u6B21\u6A5F\u6703\u56C9\u3002\u300D\n\u7B11\u5BB9\u6C92\u6709\u8B8A\uFF0C\u4F46\u4ED6\u7684\u624B\u6307\u5728\u5E3D\u6CBF\u4E0A\u6572\u5F97\u6BD4\u525B\u624D\u5FEB\u4E86\u4E00\u4E9B\u3002"
  finalFailureText: "\u574E\u8C9D\u723E\uFF1A\u300C\u5509\u5440\uFF0C\u9019\u6B21\u662F\u6211\u8D0F\u4E86\u3002\u300D\n\u4ED6\u628A\u5E3D\u5B50\u6263\u56DE\u982D\u4E0A\uFF0C\u5230\u6700\u5F8C\u4E5F\u6C92\u8B93\u4F60\u770B\u898B\u88E1\u9762\u6709\u4EC0\u9EBC\u3002"
