    successText: "\u574E\u8C9D\u723E\uFF1A\u300C\u606D\u559C\u2014\u2014\uFF01\u4F60\u731C\u5C0D\u4E86\uFF01\u88E1\u9762\u662F\u6B66\u5668\u6C92\u932F\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u64C1\u6709\u80FD\u4FDD\u8B77\u81EA\u5DF1\u7684\u529B\u91CF\u662F\u975E\u5E38\u91CD\u8981\u7684\uFF0C\u770B\u4F86\u4F60\u6DF1\u77E5\u9019\u500B\u9053\u7406\u5462\uFF0C\u5F88\u597D\uFF01\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u4F46\u6211\u4E0D\u80FD\u4FDD\u8B49\u662F\u4F60\u7528\u5F97\u8D81\u624B\u7684\u6B66\u5668\u5C31\u662F\u4E86\uFF0C\u7562\u7ADF\u662F\u96A8\u5FC3\u6311\u9078\u7684\u3002\u300D\n\n\u574E\u8C9D\u723E\uFF1A\u300C\u5C31\u7B97\u4E0D\u559C\u6B61\u4E5F\u5225\u9084\u7D66\u6211\u54E6\uFF1F\u4E0D\u7136\u6211\u54ED\u7D66\u4F60\u770B\u3002\u300D"
