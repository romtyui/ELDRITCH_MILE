  initialPrompt: "\u4E00\u540D\u91CD\u91D1\u5C6C\u6416\u6EFE\u98A8\u683C\u6253\u626E\u7684\u9752\u5E74\u7AD9\u5728\u8DEF\u65C1\uFF0C\u50CF\u6975\u4E86\u6DF1\u591C\u5C0F\u5DF7\u88E1\u7121\u6240\u4E8B\u4E8B\u7684\u5C0F\u6DF7\u6DF7\u3002\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\xB7\xB7\xB7\u554A\u2014\u2014\uFF1F\u600E\u9EBD\uFF0C\u770B\u5C41\u770B\u554A\xB7\xB7\xB7\uFF01\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\xB7\xB7\xB7\xB7\xB7\xB7\u4ED4\u7D30\u4E00\u770B\u7684\u8A71\uFF0C\u4F60\u9019\u4E0D\u662F\u4EBA\u985E\u55CE\uFF1F\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u539F\u4F86\u5982\u6B64\uFF0C\u4F60\u5C31\u662F\u90A3\u500B\u554A\u2014\u2014\u53EB\u4EC0\u9EBD\u8ABF\u67E5\u54E1\u7684\u5BB6\u5925\uFF1F\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u771F\u662F\u7684\uFF0C\u7169\u6B7B\u4E86\u3002\u8001\u5B50\u624D\u6C92\u8208\u8DA3\u966A\u4F60\u641E\u4EC0\u9EBD\u8ABF\u67E5\uFF01\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u96A8\u4FBF\u4F60\u8981\u505A\u4EC0\u9EBD\u5C31\u505A\u4EC0\u9EBD\uFF0C\u5C11\u7169\u8001\u5B50\uFF0C\u7D66\u6211\u6EFE\uFF01\u300D\n\n\u770B\u4F86\u4ED6\u7684\u5FC3\u60C5\u4E0D\u592A\u597D\xB7\xB7\xB7\u813E\u6C23\u975E\u5E38\u66B4\u8E81\u3002\n\n\u5373\u4FBF\u5982\u6B64\uFF0C\u4E5F\u8981\u8B93\u4ED6\u52A0\u5165\u55CE\xB7\xB7\xB7\uFF1F"
