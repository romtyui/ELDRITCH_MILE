    text: "\u300C\u7D66\u4ED6\u5403\u7684\uFF08\u6D88\u80171\u500B\u98DF\u7269\uFF09\u300D"
    baseProbability: 80
    acceptedAttributes: 01000000
    successText: "\u4F60\u5C07\u81EA\u5DF1\u7684\u7CE7\u98DF\u5206\u7D66\u4E86\u5C0D\u65B9\uFF0C\u4ED6\u4E00\u628A\u596A\u904E\u5730\u5F9E\u4F60\u7D66\u4E88\u7684\u98DF\u7269\uFF0C\u50CF\u91CE\u7378\u822C\u72FC\u541E\u864E\u56A5\u5730\u5403\u4E86\u4E0B\u53BB\u3002\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u5495\u5665\xB7\xB7\xB7\u5495\u5665\u2014\u2014\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u5403\u4E86\xB7\xB7\xB7\u597D\u5403\u7684\xB7\xB7\xB7\u597D\u5403\uFF1F\u96E3\u5403\uFF1F\u4E0D\u6E05\u695A\xB7\xB7\xB7\xB7\xB7\xB7\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u4F46\u662F\xB7\xB7\xB7\u8B1D\u8B1D\xB7\xB7\xB7\uFF01\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u547C\xB7\xB7\xB7\u547C\u55DA\xB7\xB7\xB7\xB7\xB7\xB7\u6C92\u4E8B\xB7\xB7\xB7\xB7\u51B7\u975C\uFF0C\u4E0B\u4F86\u4E86\u3002\u300D\n\n\u6642\u85CF\uFF1A\u300C\u6211\uFF0C\u540D\u5B57\xB7\xB7\xB7\u6642\u85CF\u3002\u662F\xB7\xB7\xB7\u662F\xB7\xB7\xB7\xB7\xB7\xB7\u6F01\u592B\uFF1F\u300D\n\n\u6642\u85CF\uFF1A\u300C\u8981\u662F\xB7\xB7\xB7\u5403\u4E86\u4EC0\u9EBD\xB7\xB7\xB7\u5C0D\u4E0D\u8D77\u3002\u809A\u5B50\xB7\xB7\xB7\u771F\u7684\u5F88\u9913\xB7\xB7\xB7\xB7\xB7\xB7\u300D\n\n\u6642\u85CF\uFF1A\u300C\u4F46\u662F\uFF0C\u6211\u6703\xB7\xB7\xB7\u5E6B\u4F60\u7684\xB7\xB7\xB7\xB7\xB7\xB7\xB7\u300D\n\n\u6642\u85CF\uFF1A\u300C\u4E00\u8D77\xB7\xB7\xB7\u52A0\u6CB9\xB7\xB7\xB7\xB7\xB7\xB7\u554A\u3001\u554A\u55DA\u2014\u2014\u300D\n\n\u6642\u85CF\uFF1A\u300C\xB7\xB7\xB7\xB7\xB7\xB7\u53C8\uFF0C\u9913\u4E86\u3002\u300D"
