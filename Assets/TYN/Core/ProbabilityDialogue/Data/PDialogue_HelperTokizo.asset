  initialPrompt: "\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u5443\u5443\xB7\xB7\xB7\u554A\u5443\xB7\xB7\xB7\xB7\xB7\xB7\uFF01\u300D\n\n\u4E00\u500B\u8EAB\u6750\u58EF\u78A9\u7684\u7537\u4EBA\u5F9E\u4E00\u65C1\u7AC4\u4E86\u51FA\u4F86\uFF0C\u8B93\u4F60\u5687\u4E86\u4E00\u8DF3\u3002\n\n\u7537\u4EBA\u7684\u52D5\u4F5C\u50CF\u662F\u6C92\u6709\u88AB\u99B4\u5316\u7684\u52D5\u7269\uFF0C\u5145\u65A5\u8457\u539F\u59CB\u7684\u91CE\u6027\uFF0C\u96AA\u4E9B\u88AB\u4F60\u7576\u6210\u662F\u602A\u7269\u7684\u4E00\u54E1\u3002\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u55DA\u55DA\xB7\xB7\xB7\xB7\xB7\xB7\uFF1F\u4F60\xB7\xB7\xB7\u662F\u2014\u2014\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\xB7\xB7\xB7\xB7\xB7\xB7\u6211\u77E5\u9053\uFF0C\u5473\u9053\u3002\u8981\u5E6B\u52A9\xB7\xB7\xB7\u4EBA\uFF0C\u4F60\uFF01\u300D\n\n\u7537\u4EBA\u7684\u8A71\u8A9E\u8B93\u4F60\u96E3\u4EE5\u7406\u89E3\uFF0C\u4F46\u4F60\u96B1\u7D04\u80FD\u611F\u53D7\u5230\u5C0D\u65B9\u7684\u5584\u610F\u3002\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\uFF08\u5495\u5695\u5695\u5695\u2014\u2014\uFF09\u300D\n\n\u7136\u800C\uFF0C\u7537\u4EBA\u809A\u5B50\u767C\u51FA\u7684\u8072\u97F3\u6253\u65B7\u4E86\u9019\u6BB5\u6478\u4E0D\u7740\u982D\u7DD2\u7684\u5C0D\u8A71\u3002\n\n\u4E0B\u4E00\u79D2\uFF0C\u7537\u4EBA\u7684\u773C\u795E\u8B8A\u5F97\u51B7\u6F20\u3002\u66F4\u5177\u9AD4\u4F86\u8AAC\xB7\xB7\xB7\u50CF\u662F\u5931\u53BB\u4E86\u7406\u6027\u3002\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\xB7\xB7\xB7\xB7\xB7\xB7\u809A\u5B50\uFF0C\u9913\u4E86\u3002\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u5403\u7684\uFF0C\u7D66\u6211\u3002\u300D\n\n\uFF1F\uFF1F\uFF1F\uFF1A\u300C\u5403\u7684\uFF0C\u7D66\u6211\u3002\u300D\n\n\u7537\u4EBA\u523B\u610F\u91CD\u8907\u4E26\u52A0\u91CD\u4E86\u8A9E\u6C23\uFF0C\u4ED6\u65B9\u624D\u7684\u5584\u610F\u4EFF\u4F5B\u88AB\u98E2\u9913\u6240\u63A9\u84CB\uFF0C\u8B8A\u5F97\u6975\u5177\u5A01\u8105\u3002\n\n\u770B\u4F86\u8981\u8B39\u614E\u5C0D\u5F85\u624D\u884C\u3002"
