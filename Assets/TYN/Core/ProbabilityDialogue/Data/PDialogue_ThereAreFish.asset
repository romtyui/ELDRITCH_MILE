  eventId: village_there_are_fish
  npcId: tokizo
  background: {fileID: 0}
  initialPrompt: "\u6642\u85CF\uFF1A\u300C\u6709\xB7\xB7\xB7\u9B5A\u3002\u300D\n\n\u8DEF\u4E0A\uFF0C\u6642\u85CF\u7A81\u7136\u505C\u4E86\u4E0B\u4F86\u3002\u5728\u4ED6\u7684\u9762\u524D\uFF0C\u6709\u4E00\u500B\u5341\u5206\u7A81\u5140\u7684\u6C60\u5858\u3002\n\n\u6C60\u5858\u975E\u5E38\u986F\u773C\u5730\u51FA\u73FE\u5728\u8DEF\u4E2D\u592E\uFF0C\u8207\u5468\u570D\u7684\u74B0\u5883\u683C\u683C\u4E0D\u5165\u3002\n\n\u6C60\u5858\u7D04\u534A\u5F912\u516C\u5C3A\u5DE6\u53F3\uFF0C\u88E1\u9762\u9084\u6709\u4E0D\u77E5\u540D\u7684\u9ED1\u8272\u5F71\u5B50\u5728\u6E38\u52D5\u3002\n\n\u6642\u85CF\uFF1A\u300C\u547C\u547C\xB7\xB7\xB7\xB7\xB7\xB7\u54C7\u554A\u2014\u2014\u300D\n\n\u66F4\u7CDF\u7CD5\u7684\u662F\uFF0C\u6709\u500B\u50CF\u5C0F\u5B69\u4E00\u6A23\u7528\u9583\u9583\u767C\u4EAE\u7684\u76EE\u5149\u6383\u8996\u6C60\u5858\u4E2D\u9ED1\u5F71\u7684\u7537\u4EBA\u3002\n\n\u6642\u85CF\uFF1A\u300C\u4F86\xB7\xB7\xB7\u6293\u9B5A\xB7\xB7\xB7\uFF01\u809A\u5B50\uFF0C\u9913\xB7\xB7\xB7\u8981\u5403\xB7\xB7\xB7\uFF01\u300D\n\n\u6642\u85CF\u7528\u671F\u5F85\u7684\u76EE\u5149\u770B\u5411\u4F60\uFF0C\u4F3C\u4E4E\u662F\u5728\u7B49\u5F85\u4F60\u7684\u610F\u898B\u3002"
  failurePrompts:
  - "\u6642\u85CF\u770B\u8457\u6C34\u9762\uFF0C\u53C8\u770B\u770B\u4F60\u3002\n\u300C...\u90A3\u500B\uFF0C\u4E0D\u884C\u55CE\uFF1F\u300D"
  - "\u6C60\u5B50\u88E1\u7684\u5F71\u5B50\u52D5\u5F97\u6162\u4E86\u4E0B\u4F86\u3002\u6642\u85CF\u7684\u809A\u5B50\u53EB\u4E86\u4E00\u8072\u3002\n\u300C\u5FEB...\u8981\u6C92\u6709\u4E86\u3002\u300D"
  finalFailureText: "\u6642\u85CF\uFF1A\u300C\u9B5A\xB7\xB7\xB7\u9B5A\xB7\xB7\xB7\xB7\xB7\xB7\u6C92\u6709\u2014\u2014\uFF1F\u300D\n\n\u5728\u4F60\u7336\u8C6B\u4E0D\u6C7A\u7684\u6642\u5019\uFF0C\u90A3\u500B\u6C60\u5858\u5C31\u5DF2\u7D93\u5728\u4E0D\u77E5\u4E0D\u89BA\u9593\u6D88\u5931\u4E86\u3002\n\n\xB7\xB7\xB7\u6642\u85CF\u770B\u8D77\u4F86\u5F88\u5931\u843D\u7684\u6A23\u5B50\u3002"
