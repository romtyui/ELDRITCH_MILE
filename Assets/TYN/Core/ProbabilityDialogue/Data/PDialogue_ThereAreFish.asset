  - optionId: scoop
    text: "\u300C\u5728\u5CB8\u908A\u6488\u6488\u770B\u5427\uFF01\u300D"
    baseProbability: 25
    acceptedAttributes: 03000000
    successText: "\u6642\u85CF\uFF1A\u300C\u6211...\u77E5\u9053\u4E86...\uFF01\u300D\n\n\u6642\u85CF\u6C92\u6709\u5192\u7136\u8DF3\u5165\u6C60\u4E2D\u6293\u9B5A\uFF0C\u800C\u662F\u4E56\u4E56\u5730\u7AD9\u5728\u6C60\u908A\u7528\u624B\u6488\u9B5A\u3002\n\u52D5\u4F5C\u770B\u4E0A\u53BB\u5C31\u50CF\u4E00\u96BB\u8C93\u3002\n\n\u904E\u4E86\u6578\u5206\u9418\uFF0C\u4F60\u807D\u898B\u6C60\u908A\u50B3\u4F86\u4E00\u9663\u52D5\u975C\u3002\n\u6642\u85CF\u5E36\u8457\u50CF\u662F\u67D0\u7A2E\u9B5A\u985E\u7684\u751F\u7269\u4F86\u5230\u4F60\u7684\u8EAB\u65C1\u3002\n\n\u6642\u85CF\uFF1A\u300C\u9019\u500B...\u7D66\u4F60\uFF01\u662F...\u8B1D\u79AE\uFF01\u4F60\u4E5F...\u5403\uFF01\u300D\n\n\u4F60\u6536\u4E0B\u4E86\u90A3\u4EFD\u79AE\u7269\uFF0C\u5118\u7BA1\u624B\u4E0A\u56E0\u6B64\u6CBE\u4E0A\u4E86\u4E00\u4E9B\u9B5A\u8165\u5473\u3002\n\u81F3\u5C11\u4ED6\u770B\u8D77\u4F86\u633A\u958B\u5FC3\u7684\u3002"
