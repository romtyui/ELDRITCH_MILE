    text: "\u300C\u8DF3\u4E0B\u53BB\u6293\u6293\u5427\uFF01\u300D"
    baseProbability: 25
    acceptedAttributes: 01000000
    successText: "\u6642\u85CF\uFF1A\u300C\u4EA4\u7D66...\u6211\uFF01\u6211\u5F88...\u64C5\u9577...\u6293\u9B5A\uFF01\u300D\n\n\u8AAA\u5B8C\uFF0C\u6642\u85CF\u4FBF\u8DF3\u5165\u6C60\u4E2D\uFF0C\u63DA\u8D77\u5DE8\u5927\u7684\u6C34\u82B1\u3002\n\u6C60\u5B50\u8868\u9762\u6062\u5FA9\u5E73\u975C\uFF0C\u5F77\u5F7F\u4EC0\u9EBC\u90FD\u6C92\u6709\u767C\u751F\u904E\u3002\n\n\u904E\u4E86\u6578\u5206\u9418\uFF0C\u6C60\u5B50\u4F9D\u820A\u6C92\u6709\u4EFB\u4F55\u52D5\u975C\u3002\n\u4F60\u4E0D\u7531\u5F97\u6709\u4E9B\u64D4\u5FC3\u3002\n\n\u5C31\u5728\u4F60\u5FD0\u5FD1\u4E0D\u5B89\u5730\u56DB\u8655\u8D70\u52D5\u6642\u2014\u2014\n\n\u6642\u85CF\uFF1A\u300C\u547C\u3001\u54C7\u554A\u2014\u2014\uFF01\u300D\n\n\u6642\u85CF\u5F9E\u6C60\u4E2D\u722C\u4E86\u4E0A\u4F86\uFF0C\u624B\u4E0A\u6293\u8457\u5E7E\u96BB\u770B\u8457\u50CF\u9B5A\u7684\u751F\u7269\u3002\n\n\u6642\u85CF\uFF1A\u300C\u5403\u98FD...\u4E86\uFF01\u9019\u662F...\u4F60\u7684\u4EFD...\uFF01\u300D\n\n\u4ED6\u628A\u525B\u6293\u5230\u7684\u6536\u7A6B\u4EA4\u7D66\u4E86\u4F60\uFF0C\u7136\u5F8C\u4E00\u526F\u6C92\u4E8B\u4EBA\u7684\u6A23\u5B50\u6E96\u5099\u7E7C\u7E8C\u524D\u9032\u3002\n\n\u4F60\u6536\u4E0B\u4E86\u90A3\u4EFD\u79AE\u7269\uFF0C\u5118\u7BA1\u624B\u4E0A\u56E0\u6B64\u6CBE\u4E0A\u4E86\u4E00\u4E9B\u9B5A\u8165\u5473\u3002\n\u81F3\u5C11\u4ED6\u770B\u8D77\u4F86\u633A\u958B\u5FC3\u7684\u3002"
