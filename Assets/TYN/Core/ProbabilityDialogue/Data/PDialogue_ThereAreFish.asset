  eventId: village_there_are_fish
  npcId: tokizo
  background: {fileID: 0}
  initialPrompt: "\u6642\u85CF\uFF1A\u300C\u9019\u88E1...\u6709\u9B5A\u3002\u300D\n\n\u8DEF\u4E0A\uFF0C\u6642\u85CF\u7A81\u7136\u505C\u4E86\u4E0B\u4F86\u3002\n\u5728\u4ED6\u7684\u9762\u524D\uFF0C\u6709\u4E00\u500B\u5341\u5206\u7A81\u5140\u7684\u6C60\u5B50\uFF0C\u88E1\u9762\u8C8C\u4F3C\u6709\u4EC0\u9EBC\u6771\u897F\u7684\u5F71\u5B50\u5728\u6E38\u52D5\u3002\n\n\u6642\u85CF\uFF1A\u300C\u4F86\u6293...\u9B5A\uFF01\u6211...\u5F88\u64C5\u9577...\u9913...\u8981\u5403\uFF01\u300D\n\n\u6642\u85CF\u770B\u5411\u4F60\uFF0C\u4F3C\u4E4E\u662F\u5728\u8A62\u554F\u4F60\u7684\u610F\u898B\u3002"
  failurePrompts:
  - "\u6642\u85CF\u770B\u8457\u6C34\u9762\uFF0C\u53C8\u770B\u770B\u4F60\u3002\n\u300C...\u90A3\u500B\uFF0C\u4E0D\u884C\u55CE\uFF1F\u300D"
  - "\u6C60\u5B50\u88E1\u7684\u5F71\u5B50\u52D5\u5F97\u6162\u4E86\u4E0B\u4F86\u3002\u6642\u85CF\u7684\u809A\u5B50\u53EB\u4E86\u4E00\u8072\u3002\n\u300C\u5FEB...\u8981\u6C92\u6709\u4E86\u3002\u300D"
  finalFailureText: "\u7B49\u4F60\u5011\u7D42\u65BC\u6C7A\u5B9A\u597D\u7684\u6642\u5019\uFF0C\u6C60\u9762\u5DF2\u7D93\u6062\u5FA9\u5E73\u975C\u4E86\u3002\n\u6642\u85CF\u8E72\u5728\u5CB8\u908A\uFF0C\u6C92\u6709\u518D\u8AAA\u8A71\u3002"
