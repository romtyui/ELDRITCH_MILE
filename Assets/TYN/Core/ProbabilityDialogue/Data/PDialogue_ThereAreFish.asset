    text: "\u300C\u5617\u8A66\u5C0B\u627E\u5468\u570D\u7684\u5DE5\u5177\u3002\u300D"
    baseProbability: 25
    acceptedAttributes: 02000000
    successText: "\u4F60\u5011\u5728\u5468\u570D\u63A2\u7D22\u4E86\u4E00\u756A\uFF0C\u627E\u5230\u4E86\u52C9\u5F37\u582A\u7528\u7684\u5DE5\u5177\u3002\n\u7B49\u56DE\u5230\u6C60\u5B50\u65C1\u908A\u6642\uFF0C\u6C60\u4E2D\u7684\u9ED1\u5F71\u5C31\u5DF2\u7D93\u6D88\u5931\u4E0D\u898B\u4E86\u3002\n\n\u96D6\u7136\u6700\u5F8C\u6C92\u80FD\u6293\u5230\u9B5A\uFF0C\u8B93\u6642\u85CF\u6709\u4E9B\u5931\u671B\uFF0C\u4F46\u525B\u624D\u627E\u5230\u7684\u5DE5\u5177\u8C8C\u4F3C\u80FD\u7528\u5728\u5176\u4ED6\u5730\u65B9\u3002"
