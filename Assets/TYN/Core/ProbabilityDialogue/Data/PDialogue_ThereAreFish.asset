    text: "\u300C\u5728\u5CB8\u908A\u6488\u6488\u770B\u5427\uFF01\u300D"
    baseProbability: 25
    acceptedAttributes: 03000000
    successText: "\u6642\u85CF\uFF1A\u300C\u6211\xB7\xB7\xB7\u77E5\u9053\u4E86\xB7\xB7\xB7\xB7\xB7\xB7\uFF01\u300D\n\n\u5F97\u5230\u5141\u8A31\u540E\uFF0C\u4ED6\u50CF\u5F97\u5230\u5BB6\u9577\u540C\u610F\u53BB\u73A9\u6C34\u7684\u5C0F\u5B69\u4E00\u6A23\u5C0F\u5FC3\u7FFC\u7FFC\u7684\u8D70\u5230\u6C60\u908A\u3002\n\n\u4ED6\u6C92\u6709\u5192\u7136\u8DF3\u5165\u6C60\u4E2D\u6293\u9B5A\uFF0C\u800C\u662F\u4E56\u4E56\u5730\u7AD9\u5728\u6C60\u908A\u7528\u624B\u6488\u9B5A\u3002\n\n\xB7\xB7\xB7\u52D5\u4F5C\u5C31\u50CF\u8C93\u4E00\u6A23\u3002\n\n\u4F60\u975C\u975C\u5730\u5728\u65C1\u908A\u770B\u8457\uFF0C\u76F4\u5230\u6578\u5206\u9418\u540E\u50B3\u4F86\u52D5\u975C\u3002\u6642\u85CF\u5E36\u8457\u985E\u4F3C\u6C34\u751F\u751F\u7269\u7684\u6B98\u9AB8\u4F86\u5230\u4F60\u7684\u9762\u524D\u3002\n\n\u6642\u85CF\uFF1A\u300C\u6293\u5230\xB7\xB7\xB7\u4E86\uFF01\u9019\u500B\xB7\xB7\xB7\u7D66\u4F60\uFF01\u300D\n\n\u90A3\u6A23\u7684\u6355\u9B5A\u65B9\u5F0F\u5C45\u7136\u771F\u7684\u80FD\u6210\u529F\u554A\xB7\xB7\xB7\xB7\xB7\xB7\n\n\u4F60\u6536\u4E0B\u4E86\u90A3\u4EFD\u79AE\u7269\uFF0C\u5118\u7BA1\u624B\u4E0A\u56E0\u6B64\u6CBE\u4E0A\u4E86\u4E00\u4E9B\u9B5A\u8165\u5473\u3002"
