  notes: "\u203B \u6230\u9B25\u7AEF\u672A\u63A5\uFF1A\u3010\u53CD\u64CA\u3011\u5C64\u6578\u9700\u8981 Romtyui \u7684 ItemEffectData\u3002\n\u203B \u7F8E\u8853\uFF1A\u6DF1\u85CD\u8272\u6216\u7D2B\u8272\u7684\u7AE0\u9B5A\u89F8\u624B\uFF0C\u4E0B\u65B9\u6709\u4E00\u7247\u626D\u66F2\u8815\u52D5\u7684\u7D50\u679C\u5F77\u5F7F\u9084\u6703\u518D\u751F\u3002"
