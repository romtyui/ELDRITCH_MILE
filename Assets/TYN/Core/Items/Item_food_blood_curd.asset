  relicEffect: {fileID: 0}
  notes: "\u203B \u6230\u9B25\u7AEF\u672A\u63A5\uFF1A\u300C\u4E0B\u6B21\u653B\u64CA\u5438\u8840\u300D\u9700\u8981 Romtyui \u7684 ItemEffectData\u3002\n\u203B \u5730\u5340\uFF1A\u57CE\u5821\uFF08\u9644\u4EF6\u6A19\u300C\u672A\u78BA\u5B9A\u300D\uFF09\u3002\n\u203B \u7F8E\u8853\uFF1A\u985E\u4F3C\u7C73\u8840\u6216\u9D28\u8840\u7684\u7D05\u8272\u65B9\u584A\u72C0\u98DF\u7269\uFF0C\u64FA\u76E4\u50CF\u67D0\u7A2E\u9AD8\u7D1A\u6CD5\u5F0F\u6599\u7406\uFF0C\u65C1\u908A\u6709\u9999\u6599\u9EDE\u7DB4\u3002"
