  relicEffect: {fileID: 0}
  notes: "\u203B \u6230\u9B25\u7AEF\u672A\u63A5\uFF1A\u3010\u7F8A\u7F94\u3011Token \u9700\u8981 Romtyui \u7684 ItemEffectData\u3002\n\u203B \u5730\u5340\uFF1A\u68EE\u6797\uFF08\u9644\u4EF6\u6A19\u300C\u672A\u78BA\u5B9A\u300D\uFF09\u3002\n\u203B \u7F8E\u8853\uFF1A\u9577\u5F97\u50CF\u5B30\u5152\u7684\u9EC3\u8272\u679C\u5BE6\uFF0C\u4E0A\u9762\u5E36\u6709\u8840\u7D72\u3002"
