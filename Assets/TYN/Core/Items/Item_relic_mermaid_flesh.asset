  consumeOnUse: 1
  relicEffect: {fileID: 0}
  notes: "\u203B \u6230\u9B25\u7AEF\u672A\u63A5\uFF1A\u9700\u8981\u65B0\u7684 RelicsEffectData \u5B50\u985E\u5225\u3002\n\u203B \u5C08\u6848\u539F\u672C\u5BEB\u300C\u6D88\u8017 10 \u9EDE SAN\u300D\uFF0C\u9644\u4EF6\u5BEB\u300C\u6E1B\u5C11\uFF08\u5C11\u91CF\uFF09SAN\u300D\u2014\u2014 \u540C\u4E00\u4EF6\u4E8B\uFF0C\u53D6 10\u3002"
