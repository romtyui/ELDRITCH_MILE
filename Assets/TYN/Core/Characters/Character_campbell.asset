  tags:
  - "\u9B54\u8853\u5E2B"
  greetings:
  - "\u4F86\uFF0C\u62BD\u724C\u5427\u3002\u770B\u770B\u9019\u4E00\u624B\u80FD\u554F\u51FA\u4EC0\u9EBC\u3002"
  - "\u60F3\u597D\u8981\u5F9E\u54EA\u88E1\u4E0B\u624B\u4E86\u55CE\uFF1F"
  - "\u5225\u6025\u3002\u724C\u5728\u624B\u4E0A\u7684\u6642\u5019\uFF0C\u6642\u9593\u662F\u4F60\u7684\u3002"
  purchaseLines: []
  chatter:
  - "\u6211\u7684\u81C9\uFF1F\u770B\u4F60\u60F3\u770B\u54EA\u4E00\u5F35\u3002"
  - "\u5225\u592A\u76F8\u4FE1\u8DEF\u6A19\uFF0C\u9019\u689D\u8DEF\u662F\u5F4E\u7684\u3002"
  successLines:
  - "\u5594\uFF1F\u9019\u4E00\u624B\u6F02\u4EAE\u3002"
  - "\u2026\u2026\u4F60\u6BD4\u4E0A\u4E00\u6B21\u66F4\u96E3\u61C9\u4ED8\u4E86\u3002"
  - "\u770B\u4F86\u6211\u5F97\u8AAA\u9EDE\u5BE6\u8A71\u4E86\u3002"
  failureLines:
  - "\u53EF\u60DC\uFF0C\u5DEE\u4E00\u9EDE\u3002"
  - "\u5475\uFF0C\u9019\u500B\u89D2\u5EA6\u6211\u65E9\u5C31\u60F3\u904E\u4E86\u3002"
  - "\u518D\u60F3\u60F3\u3002\u4F60\u9084\u6709\u724C\u3002"
  farewells:
  - "\u53BB\u5427\u3002\u6211\u6703\u5728\u8A72\u51FA\u73FE\u7684\u5730\u65B9\u51FA\u73FE\u3002"
  - "\u8DEF\u9084\u5F88\u9577\uFF0C\u5225\u628A\u529B\u6C23\u7528\u5728\u9019\u88E1\u3002"
  - "\u4E0B\u6B21\u898B\u9762\u6642\uFF0C\u5E0C\u671B\u4F60\u9084\u8A18\u5F97\u4ECA\u5929\u554F\u904E\u4EC0\u9EBC\u3002"
  conditionalChatter: []
  notes: "\u5287\u60C5\u5927\u7DB1\uFF1A\u9B54\u8853\u5E2B\uFF0F\u574E\u8C9D\u723E\u3002\u539F\u578B
    \u5948\u4E9E\u62C9\u6258\u63D0\u666E\u3002\u76F8\u95DC\u5361\u724C\uFF1A\u62BD\u53D6\u5169\u5F35\u624B\u724C\u3002\u4E0D\u6703\u8B8A\u7570\u3002\n\u26A0\uFE0F
    \u53F0\u8A5E\u662F\u4F54\u4F4D\u3002\n\u203B \u6C23\u6CE1\u53F0\u8A5E\uFF08\u62DB\u547C\uFF0F\u6210\u529F\uFF0F\u5931\u6557\uFF0F\u7D50\u8A9E\uFF09\u662F\u4F54\u4F4D\uFF0C\u8A9E\u6C23\u7167\u5927\u7DB1\u88E1\u4ED6\u7684\u53E3\u543B\u5BEB\u7684\uFF0C\u7B49\u6B63\u5F0F\u6587\u6848\u66FF\u63DB\u3002"
