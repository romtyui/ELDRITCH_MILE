  m_Script: {fileID: 11500000, guid: c7237199e4512a145a4f1e608f497672, type: 3}
  m_Name: Character_merchant
  m_EditorClassIdentifier: Assembly-CSharp::EldritchMile.Core.CharacterData
  id: merchant
  displayName: "\u5546\u4EBA"
  portrait: {fileID: 0}
  tags:
  - "\u5546\u5E97"
  - "\u79FB\u52D5\u5546\u5E97"
  - "\u51B7\u539F\u4EBA"
  greetings:
  - "\u6B61\u8FCE\u5149\u81E8\uFF5E\u8981\u4F86\u8CB7\u4E9B\u4EC0\u9EBC\u55CE\uFF1F"
  - "\u6211\u9019\u88E1\u90FD\u662F\u4E9B\u597D\u8CA8\u54E6\uFF1F\u4E00\u5B9A\u80FD\u5E6B\u4E0A\u5FD9\u7684\uFF5E\uFF01"
  - "\u5440\u2014\u2014\u53C8\u898B\u5230\u4F60\u4E86\uFF01\u9019\u6B21\u8981\u8CB7\u9EDE\u7279\u7522\u55CE\uFF1F"
  purchaseLines:
  - "\u8B1D\u8B1D\u60E0\u9867\uFF5E\u4E0B\u6B21\u4E5F\u8ACB\u52D9\u5FC5\u5149\u81E8\u672C\u5E97\u54E6\uFF1F"
  - "\u8CB7\u4E0B\u7684\u662F\u795D\u798F\u4E4B\u7269\uFF1F\u9084\u662F\u8AAA\uFF5E\u8A5B\u5492\u4E4B\u7269\uFF1F"
  - "\u597D\u2014\u2014\u7279\u8CB7\u54C1\u4E00\u4EFD\uFF5E\u96D6\u7136\u5B8C\u5168\u6C92\u6709\u7279\u50F9\u5C31\u662F\u4E86\u3002"
  chatter:
  - "\u6162\u6162\u6311\u54E6\uFF5E\u6536\u85CF\u54C1\u4E4B\u9593\u7684\u5E73\u8861\u662F\u5F88\u91CD\u8981\u7684\uFF01"
  - "\u4F60\u554F\u6211\u662F\u4EC0\u9EBC\u4EBA\uFF1F\u9019\u4EF6\u4E8B\u8AAA\u8D77\u4F86\u6709\u9EDE\u8907\u96DC\u5462~\u4EE5\u4F60\u5011\u7684\u8A71\u4F86\u8AAA...\u5B98\u65B9\u76F4\u71DF\u5E97\uFF1F"
  - "\u6211\u5728\u4F60\u7684\u8ABF\u67E5\u7BC4\u570D\u5916\u5566\uFF5E\u5225\u90A3\u9EBC\u8A8D\u771F\u770B\u5F85\u6211\u4E5F\u884C\uFF0C\u804A\u5929\u7684\u8A71\u5012\u662F\u7121\u6240\u8B02\u3002"
  - "\u5728\u5730\u7403\u554A\uFF5E\u4E0D\u662F\u6709\u53EB\u87FE\u870D\u7684\u751F\u7269\u55CE\uFF1F\u6211\u8A0E\u53AD\u90A3\u500B\u5566\uFF5E\u6703\u60F3\u8D77\u4E0D\u597D\u7684\u56DE\u61B6\uFF01"
  - "\u9019\u908A\u7279\u5225\u70BA\u60A8\u63D0\u4F9B\u6062\u5FA9san\u7684\u5FC3\u7406\u8F14\u5C0E\u670D\u52D9......\u6C92\u6709\u90A3\u7A2E\u6771\u897F\u5462\u3002"
  - "\u548C\u5354\u52A9\u8005\u641E\u597D\u95DC\u4FC2\u6C92\u6709\u4EFB\u4F55\u58DE\u8655\u5566\uFF5E\u96D6\u7136\u6703\u6709\u9EDE\u5435\uFF0C\u4F46\u65C5\u9014\u4E0A\u4E5F\u4E0D\u6703\u5B64\u55AE\u5427\uFF1F"
  - "\u5354\u52A9\u8005\u4E4B\u9593\u4E5F\u6709\u5929\u751F\u95DC\u4FC2\u4E0D\u597D\u7684\u5B58\u5728\uFF0C\u8981\u662F\u5435\u8D77\u4F86\u7684\u8A71...\u4E5F\u662F\u6C92\u8FA6\u6CD5\u7684\u4E8B\u5462\u3002"
  - "\u6F01\u6751\u7684\u50A2\u4F19\uFF0C\u5C0D\u5403\u7684\u7279\u5225\u57F7\u8457...\u6216\u8A31\u662F\u9019\u500B\u7684\u5F71\u97FF\uFF0C\u90A3\u88E1\u4E5F\u66F4\u5BB9\u6613\u627E\u5230\u7CE7\u98DF\u3002"
  - "\u6559\u5802\u90A3\u9644\u8FD1\u5F88\u4E0D\u5999\u54E6\uFF5E\u90A3\u88E1\u7684\u50A2\u4F19\u96D6\u7136\u4E0D\u6703\u4E3B\u52D5\u653B\u64CA\uFF0C\u4F46\u6703\u8CE6\u4E88\u9EBB\u7169\u7684\u6548\u679C\u3002"
  - "\u5287\u5834\u90A3\u4E00\u5E36\u5F88\u71B1\u5427\uFF1F\u7D55\u8B9A\u708E\u4E0A\u4E2D\u5566\uFF5E\u8981\u53BB\u90A3\u88E1\u7684\u8A71\u5C31\u5F97\u505A\u597D\u6062\u5FA9\u7684\u63AA\u65BD\u54E6\u3002"
  - "\u68EE\u6797\u88E1\u7684\u90A3\u4E9B\u6771\u897F\u53EA\u8AD6\u6578\u91CF\u7684\u8A71\u662F\u6700\u591A\u7684\uFF0C\u4F60\u80FD\u4E00\u6B21\u6027\u61C9\u4ED8\u5927\u91CF\u7684\u6575\u4EBA\u55CE\uFF1F"
  - "\u4F60\u53BB\u904E\u7926\u5C71\u55CE\uFF1F\u90A3\u88E1\u53EF\u4EE5\u641E\u5230\u4E00\u5927\u628A\u91D1\u5E63\u54E6\uFF5E\u6211\u6700\u559C\u6B61\u7D05\u5BF6\u77F3\u4E86\uFF01"
  - "\u7267\u5834\u7E3D\u662F\u4E94\u984F\u516D\u8272\u7684\uFF0C\u8B93\u4EBA\u773C\u82B1\u7E5A\u4E82\u5566\uFF5E\u90A3\u908A\u7684\u50A2\u4F19\u5F88\u64C5\u9577\u507D\u88DD\uFF0C\u8981\u5C0F\u5FC3\u54E6\uFF1F"
  conditionalChatter:
  - conditionId: campbell_absent
    lines:
    - "\u6211\u5BB6\u7684\u8001\u95C6\u975E\u5E38\u4E2D\u610F\u4F60\u7684\u6A23\u5B50\u5462\uFF5E\u90A3\u6A23\u7684\u8001\u95C6\u6211\u4E5F\u662F\u7B2C\u4E00\u6B21\u898B\u5230\u54E6\uFF1F"
    - "\u8001\u95C6\u4E0D\u5728\u55CE\uFF1F\u547C\uFF5E\u90A3\u5C31\u53EF\u4EE5\u5077\u61F6\u4E86......\u958B\u73A9\u7B11\u7684\u3002"
    - "\u4F60\u77E5\u9053\u55CE\uFF1F\u9019\u5BB6\u5E97\u662F\u70BA\u4E86\u4F60\u800C\u958B\u7684\u54E6\uFF1F\u8AAC\u8D77\u4F86\u9019\u597D\u50CF\u662F\u79D8\u5BC6...\u5225\u50B3\u51FA\u53BB\u54E6\uFF5E\uFF1F"
  notes: "\u5287\u60C5\u5927\u7DB1\u3008\u5546\u5E97\u3009\uFF1A\u7531\u4E00\u500B\u88DD\u626E\u602A\u7570\u7684\u5546\u4EBA\u958B\u8A2D\u7684**\u79FB\u52D5\u5546\u5E97**\uFF0C\u8CA9\u8CE3\u7A00\u5947\u53E4\u602A\u7684\u6536\u85CF\u54C1\uFF0C\n\u9019\u4E9B\u85CF\u7269\u8C8C\u4F3C\u80FD\u5920\u63D0\u4F9B\u7279\u6B8A\u7684\u529B\u91CF\u3002\n\n\u539F\u578B\uFF1A\u51B7\u539F\u4EBA\u3002\u8A9E\u6C23\u96A8\u610F\u4E2D\u5E36\u9EDE\u61F6\u6563\uFF0C\u8AAA\u8A71\u8F15\u98C4\u98C4\uFF0C\u5076\u723E\u5FC3\u8840\u4F86\u6F6E\u544A\u8A34\u73A9\u5BB6\u60C5\u5831\u3002\n\u5916\u8868\u770B\u4F3C\u4EBA\u985E\uFF0C\u982D\u4E0A\u6709\u5C0F\u7284\u89D2\uFF0C\u819A\u8272\u9EDD\u9ED1\uFF0C\u773C\u7736\u53EA\u6709\u773C\u767D\u3001\u9ED1\u6697\u4E2D\u767C\u9EC3\u5149\uFF0C\n\u5634\u88C2\u81F3\u8033\u3001\u6EFF\u53E3\u5229\u7259\uFF0C\u7E3D\u662F\u9762\u9732\u7B11\u5BB9\u3002\u4E0B\u534A\u8EAB\u985E\u4F3C\u5C71\u7F8A\uFF08\u5546\u5E97\u4ECB\u9762\u770B\u4E0D\u5230\uFF09\u3002\n\n\u203B
    \u5F69\u86CB\u689D\u4EF6 campbell_absent = \u574E\u8C9D\u723E\u4E0D\u5728\u968A\u4F0D\u5167\u3002\n 
    \u300C\u6211\u5BB6\u7684\u8001\u95C6\u300D\uFF1D\u574E\u8C9D\u723E\u3002\u76EE\u524D\u6C92\u6709\u968A\u4F0D\u7CFB\u7D71\uFF0C\u689D\u4EF6\u8981\u624B\u52D5\u5728
    CharacterHitbox \u4E0A\u586B\u3002\n\u203B \u53F0\u8A5E\u5168\u90E8\u7167\u4F01\u5283\u6587\u4EF6\u539F\u6587\uFF0C\u672A\u7D93\u6539\u5BEB\u3002"
