--- !u!114 &2258656389898980834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6791162271014101196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b656529613cdb2b408ca85038529bc44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueStageController
  introLines:
  - speaker: 
    text: "\u5ECA\u9053\u76E1\u982D\u6709\u500B\u4EBA\u9760\u8457\u7246\uFF0C\u50CF\u662F\u7B49\u4E86\u5F88\u4E45\u3002"
    portrait: {fileID: 0}
  - speaker: "\uFF1F\uFF1F\uFF1F"
    text: "\u2026\u2026\u4F60\u8D70\u5F97\u6BD4\u6211\u9810\u671F\u7684\u9060\u3002"
    portrait: {fileID: 0}
  - speaker: "\u9B54\u8853\u5E2B"
    text: "\u53EB\u6211\u574E\u8C9D\u723E\u5C31\u597D\u3002\u540D\u5B57\u9019\u7A2E\u6771\u897F\uFF0C\u6211\u6709\u5F88\u591A\u500B\u3002"
    portrait: {fileID: 0}
  - speaker: "\u9B54\u8853\u5E2B"
    text: "\u65E2\u7136\u9047\u4E0A\u4E86\uFF0C\u5C31\u804A\u9EDE\u4EC0\u9EBC\u5427\u3002\u4F60\u60F3\u5F9E\u54EA\u88E1\u554F\u8D77\uFF1F"
    portrait: {fileID: 0}
  outroLines:
  - speaker: "\u9B54\u8853\u5E2B"
    text: "\u53BB\u5427\u3002\u6211\u6703\u5728\u8A72\u51FA\u73FE\u7684\u5730\u65B9\u51FA\u73FE\u3002"
    portrait: {fileID: 0}
  options:
  - text: "\u300C\u4F60\u5230\u5E95\u662F\u4EC0\u9EBC\u6771\u897F\uFF1F\u300D"
    attribute: 2
    successSuffix: "\u3000\u2192 \u4ED6\u7B54\u4E86"
    failSuffix: "\u3000\u2192 \u4ED6\u7B11\u800C\u4E0D\u7B54"
    successText: "\u300C\u4E00\u500B\u8A18\u865F\u3002\u6709\u4EBA\u628A\u6211\u91D8\u5728\u9019\u88E1\uFF0C\u597D\u8A18\u5F97\u81EA\u5DF1\u4F86\u904E\u3002\u300D\u4ED6\u8AAA\u5F97\u5F88\u9806\uFF0C\u9806\u5230\u50CF\u6392\u7DF4\u904E\u3002"
    failText: "\u300C\u9019\u500B\u554F\u984C\u554F\u5F97\u592A\u65E9\u4E86\u3002\u300D\u4ED6\u628A\u8A71\u984C\u6298\u4E86\u56DE\u53BB\uFF0C\u4F60\u6C92\u80FD\u7E5E\u904E\u3002"
    grantItemIdsOnSuccess: []
  - text: "\u300C\u6211\u7E3D\u89BA\u5F97\u898B\u904E\u4F60\u3002\u300D"
    attribute: 1
    successSuffix: "\u3000\u2192 \u4ED6\u505C\u9813\u4E86"
    failSuffix: "\u3000\u2192 \u4ED6\u5C94\u958B\u4E86"
    successText: "\u4ED6\u7B2C\u4E00\u6B21\u505C\u9813\u3002\u300C\u2026\u2026\u6709\u610F\u601D\u3002\u90A3\u4E0D\u662F\u4F60\u7684\u8A18\u61B6\uFF0C\u662F\u9019\u500B\u4E16\u754C\u7684\u3002\u300D"
    failText: "\u300C\u6BCF\u500B\u4EBA\u90FD\u9019\u9EBC\u8AAA\u3002\u300D\u4ED6\u64FA\u64FA\u624B\uFF0C\u90A3\u500B\u505C\u9813\u6C92\u6709\u51FA\u73FE\u3002"
    grantItemIdsOnSuccess: []
  - text: "\u300C\u4F60\u8A71\u88E1\u6709\u500B\u5730\u65B9\u4E0D\u5C0D\u3002\u300D"
    attribute: 3
    successSuffix: "\u3000\u2192 \u4ED6\u8B93\u4E86\u4E00\u6B65"
    failSuffix: "\u3000\u2192 \u4ED6\u7E5E\u904E\u53BB\u4E86"
    successText: "\u300C\u88AB\u4F60\u6293\u5230\u4E86\u3002\u300D\u4ED6\u5F9E\u8896\u53E3\u53D6\u51FA\u4E00\u6A23\u6771\u897F\u64F1\u5728\u5730\u4E0A\u3002\u300C\u62FF\u53BB\uFF0C\u7B97\u6211\u8F38\u9019\u4E00\u624B\u3002\u300D"
    failText: "\u4ED6\u9806\u8457\u4F60\u7684\u8A71\u5F80\u4E0B\u8B1B\uFF0C\u8B1B\u5B8C\u4F60\u624D\u767C\u73FE\u81EA\u5DF1\u88AB\u5E36\u958B\u4E86\u3002"
    grantItemIdsOnSuccess:
    - lockpick
  explorationDeck: {fileID: 1363206467663512756}
  cardsPerEncounter: 5
