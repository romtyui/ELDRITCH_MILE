--- !u!114 &8087536917473107238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8231844150561813217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc1be16af8ce9cc4890b9f584e273a6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialEventStageController
  introLines:
  - speaker: 
    text: "\u684C\u4E0A\u6524\u8457\u4E00\u672C\u5BEB\u5230\u4E00\u534A\u7684\u7A3F\u5B50\uFF0C\u58A8\u8DE1\u9084\u6C92\u4E7E\u3002"
    portrait: {fileID: 0}
  - speaker: "\u5C0F\u8AAA\u5BB6"
    text: "\u6211\u5BEB\u904E\u9019\u4E00\u6BB5\u3002\u4F60\u6703\u5728\u9019\u88E1\u505C\u4E0B\u4F86\uFF0C\u7136\u5F8C\u62FF\u8D70\u67D0\u6A23\u4E0D\u5C6C\u65BC\u4F60\u7684\u6771\u897F\u3002"
    portrait: {fileID: 0}
  - speaker: "\u5C0F\u8AAA\u5BB6"
    text: "\u6311\u4E00\u5F35\u5427\u3002\u53CD\u6B63\u6545\u4E8B\u662F\u6211\u7DE8\u7684
      \u2014\u2014 \u5B83\u73FE\u5728\u4E5F\u662F\u771F\u7684\u4E86\u3002"
    portrait: {fileID: 0}
  outroLines:
  - speaker: 
    text: "\uFF08\u771F\u6B63\u7684\u795E\u724C\u662F\u6230\u9B25\u7528\u5361\u3001\u6B78\u6230\u9B25\u7CFB\u7D71\u7BA1\uFF0C\u9019\u88E1\u7D66\u7684\u662F\u63A2\u7D22\u724C\u66FF\u8EAB\u3002\uFF09"
    portrait: {fileID: 0}
  - speaker: "\u5C0F\u8AAA\u5BB6"
    text: "\u4E0B\u4E00\u9801\u6211\u9084\u6C92\u5BEB\u3002\u4F60\u81EA\u5DF1\u770B\u8457\u8FA6\u3002"
    portrait: {fileID: 0}
  optionsPrompt: 
  offers:
  - battleCard: {fileID: 11400000, guid: 73275e3c8c5a61146b78e6734693504f, type: 2}
    card: {fileID: 0}
    label: "\u7948\u79B1"
    takenText: "\u4F60\u8DEA\u4E86\u4E0B\u4F86\u3002\n\u6F6E\u6C34\u7684\u8072\u97F3\u5F9E\u77F3\u7E2B\u88E1\u6F2B\u4E0A\u4F86\uFF0C\u67D0\u7A2E\u51B0\u51B7\u7684\u6771\u897F\u9806\u8457\u810A\u690E\u722C\u9032\u4F60\u7684\u80F8\u53E3\u3002\n\n\u300C\u87BA\u6E6E\u300D\u7684\u724C\u9032\u4E86\u4F60\u7684\u724C\u5EAB\u3002"
  - battleCard: {fileID: 11400000, guid: 95b8f4a71a6d46f4ab65c57417877017, type: 2}
    card: {fileID: 0}
    label: "\u7121\u8996"
    takenText: "\u4F60\u5225\u958B\u8996\u7DDA\uFF0C\u7E5E\u904E\u90A3\u5EA7\u796D\u58C7\u3002\n\u80CC\u5F8C\u6C92\u6709\u8072\u97F3\uFF0C\u4F46\u4F60\u77E5\u9053\u6709\u6771\u897F\u8A18\u4F4F\u4E86\u4F60\u3002\n\n\u300C\u6208\u5384\u5FD2\u300D\u7684\u724C\u9032\u4E86\u4F60\u7684\u724C\u5EAB\u3002"
  defaultTakenFormat: "\u300C{0}\u300D\u9032\u4E86\u4F60\u7684\u724C\u7D44\u3002"
