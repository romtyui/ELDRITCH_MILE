--- !u!114 &8087536917473107238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8231844150561813217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc1be16af8ce9cc4890b9f584e273a6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialEventStageController
  introLines:
  - speaker: 
    text: "\u4F60\u4F86\u5230\u4E00\u5EA7\u5EE2\u68C4\u7684\u796D\u58C7\uFF0C\u6B64\u8655\u6563\u767C\u8457\u4E0D\u8A73\u7684\u6C23\u606F\uFF0C\u8B93\u4F60\u4E0D\u5BD2\u800C\u6144\u3002"
    portrait: {fileID: 0}
  - speaker: 
    text: "\u796D\u58C7\u7684\u4E2D\u9593\u6709\u5EA7\u640D\u58DE\u7684\u96D5\u50CF\uFF0C\u5DF2\u7D93\u7121\u6CD5\u8FA8\u8B58\u5177\u9AD4\u7684\u9762\u76EE\u3002\u82E5\u5411\u5176\u737B\u4E0A\u7948\u79B1\uFF0C\u6216\u8A31\u53EF\u4EE5\u5F97\u5230\u795E\u660E\u7684\u4F51\u8B77......"
    portrait: {fileID: 0}
  outroLines: []
  optionsPrompt: "\u4F60\u8981\u505A\u4EC0\u9EBC\uFF1F"
  altarView: {fileID: 7910115740081543860}
  offers:
  - battleCard: {fileID: 11400000, guid: 73275e3c8c5a61146b78e6734693504f, type: 2}
    card: {fileID: 0}
    label: "\u7948\u79B1"
    takenText: "\u4F86\u81EA\u60A0\u4E45\u6DF1\u57DF\u7684\u795E\u660E\u56DE\u61C9\u4E86\u4F60\uFF0C\u672A\u77E5\u7684\u529B\u91CF\u6D8C\u73FE\u4E86\u51FA\u4F86\u3002\n\n\u3010\u6DF1\u6DF5\u3011\u7684\u724C\u9032\u4E86\u4F60\u7684\u724C\u5EAB\u3002"
  - battleCard: {fileID: 11400000, guid: 95b8f4a71a6d46f4ab65c57417877017, type: 2}
