  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc1be16af8ce9cc4890b9f584e273a6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialEventStageController
  introLines:
  - speaker: 
    text: "\u77F3\u968E\u76E1\u982D\u662F\u4E00\u5EA7\u796D\u58C7\u3002\n\u5B83\u584C\u4E86\u4E00\u534A\uFF0C\u4F9B\u53F0\u4E0A\u7684\u6771\u897F\u65E9\u5C31\u88AB\u4EBA\u62FF\u8D70\u4E86\u3002"
    portrait: {fileID: 0}
  - speaker: 
    text: "\u5269\u4E0B\u7684\u51F9\u69FD\u88E1\u7A4D\u8457\u6C34\u3002\u6C34\u9762\u6C92\u6709\u6620\u51FA\u4F60\u7684\u81C9\u3002"
    portrait: {fileID: 0}
  outroLines:
  - speaker: 
    text: "\u51F9\u69FD\u88E1\u7684\u6C34\u9762\u6062\u5FA9\u5E73\u975C\u3002\n\u796D\u58C7\u4ECD\u7136\u662F\u584C\u7684\u3002"
    portrait: {fileID: 0}
  optionsPrompt: "\u4F60\u8981\u505A\u4EC0\u9EBC\uFF1F"
  offers:
  - battleCard: {fileID: 11400000, guid: 73275e3c8c5a61146b78e6734693504f, type: 2}
    card: {fileID: 0}
    label: "\u7948\u79B1"
    takenText: "\u4F60\u8DEA\u4E86\u4E0B\u4F86\u3002\n\u6F6E\u6C34\u7684\u8072\u97F3\u5F9E\u77F3\u7E2B\u88E1\u6F2B\u4E0A\u4F86\uFF0C\u67D0\u7A2E\u51B0\u51B7\u7684\u6771\u897F\u9806\u8457\u810A\u690E\u722C\u9032\u4F60\u7684\u80F8\u53E3\u3002\n\n\u3010\u6DF1\u6DF5\u3011\u7684\u724C\u9032\u4E86\u4F60\u7684\u724C\u5EAB\u3002"
  - battleCard: {fileID: 11400000, guid: 95b8f4a71a6d46f4ab65c57417877017, type: 2}
    card: {fileID: 0}
    label: "\u7121\u8996"
    takenText: "\u4F60\u5225\u958B\u8996\u7DDA\uFF0C\u7E5E\u904E\u90A3\u5EA7\u796D\u58C7\u3002\n\u80CC\u5F8C\u6C92\u6709\u8072\u97F3\uFF0C\u4F46\u4F60\u77E5\u9053\u6709\u6771\u897F\u8A18\u4F4F\u4E86\u4F60\u3002\n\n\u3010GOAT\u3011\u7684\u724C\u9032\u4E86\u4F60\u7684\u724C\u5EAB\u3002"
  defaultTakenFormat: "\u300C{0}\u300D\u9032\u4E86\u4F60\u7684\u724C\u7D44\u3002"
