  dialogueLines:
  - speaker: {fileID: 11400000, guid: 072085e8c94647149a700adcd64b275d, type: 2}
    overridePortraitSide: 0
    portraitSide: 0
    text: "\u8981\u6CE8\u610F\u7684\u662F\uFF0C\u4F7F\u7528\u5361\u724C\u6703\u5C0D\u4F60\u7684\u7CBE\u795E\u9020\u6210\u8CA0\u64D4\u3002\r\n\t\t\u4F60\u624B\u4E0A\u7684\u6CB9\u71C8\u6703\u9AD4\u73FE\u51FA\u4F60\u73FE\u6709\u7684\u7406\u667A\uFF0C\u4F60\u7684\u7CBE\u795E\u8D8A\u8870\u5F31\uFF0C\u706B\u5149\u5C31\u8D8A\u5FAE\u5F31\u3002\r\n"
    useTypewriter: 0
    typewriterInterval: 0
    allowClickToCompleteText: 0
  - speaker: {fileID: 11400000, guid: 072085e8c94647149a700adcd64b275d, type: 2}
    overridePortraitSide: 0
    portraitSide: 0
    text: "\u8981\u662F\u7CBE\u795E\u904E\u65BC\u8870\u5F31\uFF0C\u5468\u570D\u5C31\u6703\u9677\u5165\u9ED1\u6697\uFF0C\u5230\u6642\u5019\u6703\u767C\u751F\u66F4\u56B4\u91CD\u7684\u4E8B\u60C5\u5427\u3002\r\n\t\t\u96D6\u7136\u5F88\u8F9B\u82E6\uFF0C\u4F46\u8981\u6CE8\u610F\u4E0D\u8981\u8017\u76E1\u81EA\u5DF1\u7684\u7406\u667A\u54E6\uFF01\r\n\r\n"
    useTypewriter: 0
    typewriterInterval: 0
    allowClickToCompleteText: 0
  - speaker: {fileID: 11400000, guid: 072085e8c94647149a700adcd64b275d, type: 2}
    overridePortraitSide: 0
    portraitSide: 0
    text: "\u5982\u679C\u624B\u4E0A\u6C92\u6709\u60F3\u4F7F\u7528\u7684\u5361\u724C\u7684\u8A71\uFF0C\u4E5F\u53EF\u4EE5\u9078\u64C7\u4E0D\u4F7F\u7528\uFF0C\u7B49\u5F85\u5C0D\u624B\u7684\u884C\u52D5\u3002\r\n\t\t\u7C73\u53EF\u6703\u5728\u9019\u500B\u6642\u5019\u628A\u4F60\u4E0D\u7528\u7684\u5361\u724C\u5403\u6389\uFF0C\u60F3\u518D\u6B21\u62BD\u53D6\u7684\u8A71\u53EA\u80FD\u7B49\u5F85\u4E0B\u4E00\u8F2A\u4E86\u3002\r\n"
    useTypewriter: 0
    typewriterInterval: 0
    allowClickToCompleteText: 0
  message: "\u5361\u724C\u5DE6\u4E0A\u89D2\u7684\u6578\u5B57\u662F\u6D88\u8017\u3002\u6253\u51FA\u5361\u724C\u6703\u6D88\u8017
    SAN\u3002"
